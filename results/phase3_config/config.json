{
  "data_dir": "./chromatin_data",
  "output_dir": "./chromatin_phase3_clean",
  "hierarchy_json": "./manifold-dim-reduct/phase8/label_hierarchy_v2.json",
  "seed": 42,
  "num_epochs": 40,
  "batch_size": 512,
  "num_workers": 2,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "warmup_epochs": 3,
  "lr_min": 1e-06,
  "label_smoothing": 0.05,
  "grad_clip": 3.0,
  "seq_len": 200,
  "rc_augment": true,
  "jitter_prob": 0.3,
  "jitter_min_len": 180,
  "noise_prob": 0.02,
  "hierarchy_enabled": true,
  "family_loss_weight": 0.3,
  "consistency_loss_weight": 0.1,
  "rc_consistency_enabled": true,
  "rc_consistency_weight": 0.05,
  "rc_consistency_mode": "mse",
  "use_precomputed_features": false,
  "precomputed_feature_dir": null,
  "feature_dim": 0
}